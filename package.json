{
  "name": "mysql2-mcp-server",
  "version": "2.0.1",
  "description": "MySQL MCP server that enables AI assistants to interact with MySQL databases. Supports direct connection, SSH tunnel, connection pool, transactions, and security enforcement.",
  "main": "index.js",
  "type": "module",
  "bin": {
    "mysql2-mcp-server": "./index.js"
  },
  "files": [
    "index.js",
    "lib/",
    "README.md",
    "config.example.json",
    "smithery.yaml"
  ],
  "engines": {
    "node": ">=18.14.1"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node smoke-test.js",
    "prepublishOnly": "node smoke-test.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "mysql",
    "mysql2",
    "mysql-mcp-server",
    "model-context-protocol",
    "ssh-tunnel",
    "ssh",
    "readonly",
    "multi-environment",
    "database",
    "ai-tools",
    "claude",
    "claude-desktop",
    "cursor"
  ],
  "author": "jcxy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcxy/mysql-mcp-server.git"
  },
  "homepage": "https://github.com/jcxy/mysql-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/jcxy/mysql-mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "mysql2": "^3.18.0",
    "ssh2": "^1.17.0"
  }
}
